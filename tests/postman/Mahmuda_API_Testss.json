    {
      "name": "get all users",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response is JSON\", function () {\r",
              "    pm.response.to.be.json;\r",
              "});\r",
              "\r",
              "pm.test(\"Response is an array\", function () {\r",
              "    const data = pm.response.json();\r",
              "    pm.expect(data).to.be.an(\"array\");\r",
              "});\r",
              "\r",
              "pm.test(\"10 users are returned\", function () {\r",
              "    const data = pm.response.json();\r",
              "    pm.expect(data).to.have.lengthOf(10);\r",
              "});\r",
              "\r",
              "pm.test(\"First user ID is 1\", function () {\r",
              "    const data = pm.response.json();\r",
              "    pm.expect(data[0].id).to.eql(1);\r",
              "});\r",
              "\r",
              "pm.test(\"Every user has name and email\", function () {\r",
              "    const data = pm.response.json();\r",
              "\r",
              "    data.forEach(function (user) {\r",
              "        pm.expect(user).to.have.property(\"name\");\r",
              "        pm.expect(user).to.have.property(\"email\");\r",
              "    });\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users"
          ]
        }
